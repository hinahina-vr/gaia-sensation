# Copy to .dev.vars for local development. Never commit real values.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
SESSION_SECRET=replace-with-at-least-32-random-bytes
DEVICE_TOKEN_PEPPER=replace-with-independent-at-least-32-random-bytes
PAIRING_CODE_PEPPER=replace-with-independent-at-least-32-random-bytes
