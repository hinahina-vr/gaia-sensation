{
  "name": "@gaia-senseware/sensor-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types ./src/worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "build:pages-worker": "node ../scripts/build-sensor-pages-worker.mjs",
    "check:pages-worker": "node ../scripts/build-sensor-pages-worker.mjs --check",
    "test:pages": "node ./test/run-pages-functions-tests.mjs",
    "check": "npm run types && npm run typecheck && npm run check:pages-worker && wrangler deploy --dry-run --outdir ../artifacts/sensor-platform-dry-run",
    "db:migrate:local": "wrangler d1 migrations apply gaia-senseware-sensors-local --local",
    "dev": "wrangler dev --local --port 8787"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "4.121.0"
  }
}
